// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  COORDINATOR
  TEAM_MEMBER
  RELIEF_STAFF
  ADMIN
}

enum RescueRequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RescueRequestStatus {
  CREATED
  VERIFYING
  INVALID
  VERIFIED
  PRIORITIZED
  WAITING_FOR_TEAM
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  RESCUE_FAILED
  CANCELLED
}

enum RescueTeamStatus {
  AVAILABLE
  ON_MISSION
  OFFLINE
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  FAILED
  COMPLETED
  CANCELLED
}

model User {
  id             String          @id @default(uuid()) @db.VarChar(36)
  name           String          @db.VarChar(255)
  phone          String          @db.VarChar(20)
  email          String?         @unique @db.VarChar(255)
  password       String          @db.VarChar(255)
  role           UserRole
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  rescueRequests RescueRequest[]
  auditLogs      AuditLog[]

  @@map("users")
}

model RescueRequest {
  id              String                 @id @default(uuid()) @db.VarChar(36)
  requesterId     String                 @map("requester_id") @db.VarChar(36)
  locationAddress String                 @map("location_address") @db.VarChar(500)
  latitude        Decimal?               @db.Decimal(10, 7)
  longitude       Decimal?               @db.Decimal(10, 7)
  peopleCount     Int                    @map("people_count")
  description     String?                @db.Text
  priority        RescueRequestPriority?
  status          RescueRequestStatus
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  requester       User                   @relation(fields: [requesterId], references: [id])
  assignments     Assignment[]

  @@index([requesterId], map: "idx_rescuerequest_requester_id")
  @@index([status], map: "idx_rescuerequest_status")
  @@index([priority], map: "idx_rescuerequest_priority")
  @@index([latitude, longitude], map: "idx_rescuerequest_coords")
  @@map("rescue_requests")
}

model RescueTeam {
  id                String           @id @default(uuid()) @db.VarChar(36)
  name              String           @db.VarChar(255)
  status            RescueTeamStatus
  capacity          Int
  capability        String?          @db.VarChar(255)
  currentLatitude   Decimal?         @map("current_latitude") @db.Decimal(10, 7)
  currentLongitude  Decimal?         @map("current_longitude") @db.Decimal(10, 7)
  locationAccuracy  Decimal?         @map("location_accuracy") @db.Decimal(8, 2)
  locationUpdatedAt DateTime?        @map("location_updated_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  assignments       Assignment[]

  @@index([currentLatitude, currentLongitude], map: "idx_rescueteam_coords")
  @@map("rescue_teams")
}

model Assignment {
  id              String           @id @default(uuid()) @db.VarChar(36)
  rescueRequestId String           @map("rescue_request_id") @db.VarChar(36)
  rescueTeamId    String           @map("rescue_team_id") @db.VarChar(36)
  status          AssignmentStatus
  assignedAt      DateTime         @default(now()) @map("assigned_at")
  acceptedAt      DateTime?        @map("accepted_at")
  rejectedAt      DateTime?        @map("rejected_at")
  startedAt       DateTime?        @map("started_at")
  completedAt     DateTime?        @map("completed_at")
  failedAt        DateTime?        @map("failed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rescueRequest   RescueRequest    @relation(fields: [rescueRequestId], references: [id])
  rescueTeam      RescueTeam       @relation(fields: [rescueTeamId], references: [id])

  @@index([rescueRequestId], map: "idx_assignment_rescue_request_id")
  @@index([rescueTeamId], map: "idx_assignment_rescue_team_id")
  @@index([status], map: "idx_assignment_status")
  @@map("assignments")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String?  @map("user_id") @db.VarChar(36)
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(36)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id])

  @@index([createdAt], map: "idx_audit_created_at")
  @@index([userId], map: "idx_audit_user_id")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@map("audit_logs")
}

